generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id          Int     @id @default(autoincrement())
  store_id    Int
  name        String
  description String?
  icon_id     String?

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  stores   stores     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products products[]

  @@index([store_id])
}

model images {
  id  Int    @id @default(autoincrement())
  url String

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  products products[]
  users    users[]
}

model locations {
  id           Int     @id @default(autoincrement())
  store_id     Int
  name         String
  description  String?
  max_capacity Int     @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  stores stores @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

model roles {
  id          Int    @id @default(autoincrement())
  name        String @unique
  permissions Json   @default("{}")

  users         users[]
}

model users {
  id               Int    @id @default(autoincrement())
  username         String @unique
  email            String @unique
  password_hash    String
  profile_image_id Int?
  role_id          Int

  is_active  Boolean   @default(true)
  last_login DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  images                images?                   @relation(fields: [profile_image_id], references: [id])
  roles                 roles                     @relation(fields: [role_id], references: [id])
  ownedStores           stores[]                  @relation("StoreOwner")
  storeMemberships      store_members[]
  productStockMovements product_stock_movements[]
  createdOrders         orders[]                  @relation("OrderCreator")
  voidedOrders          orders[]                  @relation("OrderVoider")
  aiChatMessages        ai_chat_messages[]

  @@index([role_id])
}

model stores {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  owner_id    Int
  description String?
  icon        String?
  is_active   Boolean @default(true)

  receipt_header String?
  receipt_footer String?
  receipt_tax_id String?
  promptpay_id   String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  owner          users                     @relation("StoreOwner", fields: [owner_id], references: [id])
  members        store_members[]
  categories     categories[]
  locations      locations[]
  products       products[]
  movements      product_stock_movements[]
  orders         orders[]
  aiChatMessages ai_chat_messages[]

  @@index([owner_id])
}



model ai_chat_messages {
  id         BigInt   @id @default(autoincrement())
  store_id   Int
  user_id    Int
  role       String   // user | assistant
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)

  store stores @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user  users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([store_id, user_id, created_at])
}

model store_members {
  id       Int @id @default(autoincrement())
  store_id Int
  user_id  Int
  job_title   String?
  permissions Json     @default("{}")

  created_at DateTime @default(now()) @db.Timestamptz(6)

  store stores @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([store_id, user_id])
  @@index([store_id])
  @@index([user_id])
}

model products {
  id          Int     @id @default(autoincrement())
  store_id    Int
  sku         String
  category_id Int
  name        String
  description String?

  cost_price    Decimal @default(0) @db.Decimal(12, 2)
  selling_price Decimal @default(0) @db.Decimal(12, 2)

  image_id  Int?
  is_active Boolean @default(true)

  stock_on_hand Int @default(0)
  reorder_point Int @default(0)

  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)
  stock_updated_at DateTime @default(now()) @db.Timestamptz(6)

  stores     stores     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  categories categories @relation(fields: [category_id], references: [id])
  images     images?    @relation(fields: [image_id], references: [id])

  product_stock_movements product_stock_movements[]
  order_items             order_items[]

  @@unique([store_id, sku])
  @@index([store_id])
  @@index([category_id])
  @@index([is_active])
}

model product_stock_movements {
  id         BigInt @id @default(autoincrement())
  store_id   Int
  product_id Int
  delta      Int
  reason     String
  note       String?
  created_by Int?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  stores   stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users    users?   @relation(fields: [created_by], references: [id])

  @@index([store_id])
  @@index([product_id, created_at])
}

model orders {
  id            Int       @id @default(autoincrement())
  store_id      Int
  order_number  String
  status        String    @default("completed") // completed | voided | pending
  payment_method String                         // cash | promptpay

  webhook_id_pay  String?   @unique
  promptpay_amount Decimal? @db.Decimal(12, 2)

  subtotal      Decimal   @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)

  amount_received Decimal? @db.Decimal(12, 2)
  change_amount   Decimal? @db.Decimal(12, 2)

  note          String?
  created_by    Int
  voided_by     Int?
  voided_at     DateTime? @db.Timestamptz(6)

  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  store         stores      @relation(fields: [store_id], references: [id], onDelete: Cascade)
  creator       users       @relation("OrderCreator", fields: [created_by], references: [id])
  voider        users?      @relation("OrderVoider", fields: [voided_by], references: [id])
  items         order_items[]

  @@unique([store_id, order_number])
  @@index([store_id, created_at])
  @@index([store_id, status])
}

model order_items {
  id            Int     @id @default(autoincrement())
  order_id      Int
  product_id    Int
  product_name  String
  product_sku   String
  quantity      Int
  unit_price    Decimal @db.Decimal(12, 2)
  total_price   Decimal @db.Decimal(12, 2)

  order         orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product       products @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
}
